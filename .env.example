# Core
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000

# Database (SQLite for local, PostgreSQL for production)
DATABASE_URL=file:./dev.db
# DATABASE_URL=postgresql://bs:bs@localhost:5432/borderscout

# Auth
JWT_ACCESS_SECRET=borderscout-access-secret-change-in-prod
JWT_REFRESH_SECRET=borderscout-refresh-secret-change-in-prod
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Google OAuth (optional for local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODEL_PROVIDER=mock
MODEL_BUDGET_USD_PER_PIPELINE=0.50

# Stripe (optional for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS
CORS_ORIGIN=http://localhost:3000
